# OS noise
.DS_Store

# Secrets & credentials — never commit real values; use *_REF placeholders +
# environment variables / keychain / secret manager (see SECURITY.md).
.env
.env.*
!.env.example
*.credentials
*credentials*.json
*.pem
*.key

# Local-only notes and overrides (per-machine, may hold sensitive context)
*.local.md
.claude/settings.local.json

# Runtime artifacts from verifies / watchdog (may capture app state or PII)
screenshots/
*.png
*.jpg
hang-*.log
watchdog-*.log
heartbeats/

# Scratch / reconciliation temp files
*.tmp
*.reconcile.json
.team-loop/

# Router/Worker offline artifacts and interrupted publication scratch
*.rw-draft.json
*.rw-retries.sqlite
*.rw-retries.sqlite-journal
*.rw-retries.sqlite-wal
*.rw-retries.sqlite-shm
.rw-draft-*/
*.rw-staging/
*.rw-active/
.rw-retries-*/
*.rw-settlement.json

# Internal working docs (kept local, not published)
ai-team-quality-improvement-plan.md

# Python bytecode (tests/op_board_test.py)
__pycache__/
*.pyc

# Rollout acceptance evidence (owner decision 2026-10-06: local only, never committed)
docs/rollout-evidence/

# Rollout planning docs (owner decision 2026-10-06: local only)
docs/loop-graph-rollout-plan.md
docs/loop-graph-rollout-handoff.md

# The kit's own development ledgers (ADR 0009 decision 5): local to the
# maintainer's checkout, never committed. The kit ships only their seeds
# (*.template.md), which bootstrap copies into each project instance.
/agents/lifecycle.md
/agents/lessons.md
/agents/archive/
/memory/pm.md
/memory/pm-archive-*.md
/pm-decisions.md
/pm-decisions-archive-*.md
/messages/*.md
!/messages/README.md
